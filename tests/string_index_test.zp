fun main() Int {
    if "text"[2] != 'x' {
        return 1;
    }

    var owned: String = "zap";
    if owned[1] != 'a' {
        return 2;
    }

    var borrowed: StringView = "borrowed";
    if borrowed[3] != 'r' {
        return 3;
    }

    if "text"[-1] != '\0' {
        return 4;
    }
    if "text"[4] != '\0' {
        return 5;
    }

    return 0;
}
