import "std/json";

fun main() Int {
    var parser: json.JsonParser = new json.JsonParser("{\"tag_name\":\"v1.2\\n0\",\"draft\":false,\"score\":-1.25e2,\"assets\":[null,true,{\"name\":\"zap\"}]}");
    var value: json.JsonValue = parser.parse();
    if !value.valid || value.type != json.JsonType.OBJECT {
        return 1;
    }

    var objectParser: json.JsonParser = new json.JsonParser("{\"tag_name\":\"v1.2\\n0\",\"draft\":false,\"score\":-1.25e2,\"assets\":[null,true,{\"name\":\"zap\"}]}");
    var object: json.JsonObject = objectParser.parseObjectFields();
    if !object.valid || !object.has("tag_name") || !object.has("assets") {
        return 2;
    }
    if object.get("tag_name").stringVal != "v1.2\n0" {
        return 3;
    }
    if object.get("draft").boolVal {
        return 4;
    }
    if object.get("score").numberVal < -125.1 || object.get("score").numberVal > -124.9 {
        return 5;
    }
    if object.get("assets").arrayVal.len() != 3 {
        return 6;
    }
    return 0;
}
