import "std/math";

fun main() Int {
    if math.PI < 3.14 || math.PI > 3.15 {
        return 1;
    }
    if math.E < 2.71 || math.E > 2.72 {
        return 2;
    }

    if math.abs(-10.5) != 10.5 {
        return 3;
    }
    if math.min(3.5, 1.2) != 1.2 {
        return 4;
    }
    if math.max(3.5, 1.2) != 3.5 {
        return 5;
    }
    if math.clamp(15, 0, 10) != 10 {
        return 6;
    }
    if math.clamp(-5, 0, 10) != 0 {
        return 7;
    }
    if math.clamp(5, 0, 10) != 5 {
        return 8;
    }

    if math.round(3.6) != 4.0 {
        return 9;
    }
    if math.trunc(3.9) != 3.0 {
        return 10;
    }
    if math.pow(2.0, 3.0) != 8.0 {
        return 11;
    }
    if math.log10(100.0) != 2.0 {
        return 12;
    }

    var rad: Float64 = math.degToRad(180.0);
    if math.abs(rad - math.PI) > 0.0001 {
        return 13;
    }
    if math.abs(math.sin(math.PI / 2.0) - 1.0) > 0.0001 {
        return 14;
    }
    if math.abs(math.cos(0.0) - 1.0) > 0.0001 {
        return 15;
    }

    if math.gcd(48, 18) != 6 {
        return 16;
    }
    if math.lcm(4, 6) != 12 {
        return 17;
    }
    if !math.isPowerOfTwo(16) {
        return 18;
    }
    if math.isPowerOfTwo(18) {
        return 19;
    }
    if math.nextPowerOfTwo(10) != 16 {
        return 20;
    }
    if math.nextPowerOfTwo(4611686018427387905) != 0 {
        return 21;
    }

    return 0;
}
