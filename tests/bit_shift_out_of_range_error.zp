fun main() Int {
    var x: Int32 = 1;
    var y: UInt32 = 1;

    // Fixed-width Int32 rejects shifts equal to its width.
    var badIntEqWidth: Int32 = x << 32;

    // Shift amount greater than width is also out of range.
    var badIntGtWidth: Int32 = x >> 40;

    // Fixed-width UInt32 follows the same rule.
    var badUIntEqWidth: UInt32 = y << 32;

    // And larger values remain out of range.
    var badUIntGtWidth: UInt32 = y >> 64;

    return badIntEqWidth + badIntGtWidth + (badUIntEqWidth as Int) + (badUIntGtWidth as Int);
}
