import "std/strings";

import "std/mem";
import "std/io";
import "core" { StringView };

pub ext fun exit(code: Int) Void;
pub ext fun argc() Int;
pub ext fun argv(i: Int) String;

ext fun getenv(name: *Char) *Char;
ext fun getcwd(buffer: *Char, size: UInt) *Char;
ext fun system(command: *Char) Int32;

pub fun getEnv(name: String) String {
  var nameBuf = strings.makeNullTerm(name);
  if (nameBuf == null) {
    return "";
  }

  var value = getenv(nameBuf);
  if (value == null) {
    mem.free(nameBuf as *Void);
    return "";
  }

  var result: String;
  unsafe {
    result = strings.fromNullTerm(value);
  }

  mem.free(nameBuf as *Void);
  return result;
}

pub fun exec(command: noescape StringView) Int {
  var commandBuf = strings.makeNullTerm(command);
  if (commandBuf == null) {
    return -1;
  }

  var status: Int32 = system(commandBuf);
  mem.free(commandBuf as *Void);

  if (status < 0) {
    return status as Int;
  }
  if (status & 0x7f) == 0 {
    return (status >> 8) as Int;
  }
  return status as Int;
}

pub fun cwd() String {
  var path = getcwd(null, 0);
  if (path == null) {
    return "";
  }

  var result: String;
  unsafe {
    result = strings.fromNullTerm(path);
  }
  mem.free(path as *Void);
  return result;
}

pub fun panic(message: String) Void {
  io.eprintln(message);
  exit(1);
}
