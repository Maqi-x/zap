import "std/path";
import "std/string";
import "std/collection";
import "std/strings";
import "std/mem";
import "core" { StringView, getDataPtr, len };

alias Dir = Void;
alias File = Void;

ext fun __errno_location() *Int32;
ext fun access(path: *Char, mode: Int32) Int32;
ext fun opendir(path: *Char) *Dir;
ext fun closedir(dir: *Dir) Int32;
ext fun readlink(path: *Char, buffer: *Char, size: UInt) Int;
ext fun realpath(path: *Char, resolved: *Char) *Char;
ext fun mkdir(path: *Char, mode: UInt) Int32;
ext fun remove(path: *Char) Int32;
ext fun rename(from: *Char, to: *Char) Int32;
ext fun fopen(path: *Char, mode: *Char) *File;
ext fun fclose(file: *File) Int32;
ext fun fseek(file: *File, offset: Int, origin: Int32) Int32;
ext fun ftell(file: *File) Int;
ext fun fread(buffer: *Void, size: UInt, count: UInt, file: *File) UInt;
ext fun fwrite(buffer: *Void, size: UInt, count: UInt, file: *File) UInt;
ext fun zap_string_from_ptrlen(ptr: *Char, len: Int) String;

@error
pub enum FsError {
  PermissionDenied,
  NotFound,
  AlreadyExists,
  NotDirectory,
  IsDirectory,
  InvalidPath,
  OutOfMemory,
  Io,
}

fun errorFromCode(code: Int) FsError {
  if code == 2 {
    return FsError.NotFound;
  }
  if code == 12 {
    return FsError.OutOfMemory;
  }
  if code == 13 {
    return FsError.PermissionDenied;
  }
  if code == 17 {
    return FsError.AlreadyExists;
  }
  if code == 20 {
    return FsError.NotDirectory;
  }
  if code == 21 {
    return FsError.IsDirectory;
  }
  if code == 22 {
    return FsError.InvalidPath;
  }
  return FsError.Io;
}

fun failOnCode(code: Int) Void!FsError {
  if code != 0 {
    fail errorFromCode(code);
    return;
  }
  return;
}

fun lastErrorCode() Int {
  unsafe {
    return *__errno_location() as Int;
  }
}

fun pathBuffer(path: noescape StringView) *Char {
  return strings.makeNullTerm(path);
}

pub fun exists(target: noescape StringView) Bool {
  var pathBuf = pathBuffer(target);
  if pathBuf == null {
    return false;
  }
  var result = access(pathBuf, 0) == 0;
  mem.free(pathBuf as *Void);
  return result;
}

pub fun isDir(target: noescape StringView) Bool {
  var pathBuf = pathBuffer(target);
  if pathBuf == null {
    return false;
  }
  var dir = opendir(pathBuf);
  mem.free(pathBuf as *Void);
  if dir == null {
    return false;
  }
  closedir(dir);
  return true;
}

pub fun isSymlink(target: noescape StringView) Bool {
  var pathBuf = pathBuffer(target);
  if pathBuf == null {
    return false;
  }
  var probe = mem.malloc(1) as *Char;
  if probe == null {
    mem.free(pathBuf as *Void);
    return false;
  }
  var result = readlink(pathBuf, probe, 1) >= 0;
  mem.free(probe as *Void);
  mem.free(pathBuf as *Void);
  return result;
}

pub fun isFile(target: noescape StringView) Bool {
  if !exists(target) || isDir(target) {
    return false;
  }
  if !isSymlink(target) {
    return true;
  }

  var pathBuf = pathBuffer(target);
  if pathBuf == null {
    return false;
  }
  var resolved = realpath(pathBuf, null);
  mem.free(pathBuf as *Void);
  if resolved == null {
    return false;
  }
  var dir = opendir(resolved);
  mem.free(resolved as *Void);
  if dir == null {
    return true;
  }
  closedir(dir);
  return false;
}

pub fun mkdir(target: noescape StringView) Void!FsError {
  var pathBuf = pathBuffer(target);
  if pathBuf == null {
    fail FsError.OutOfMemory;
    return;
  }
  var result = mkdir(pathBuf, 0o777);
  var code = result == 0 ? 0 : lastErrorCode();
  mem.free(pathBuf as *Void);
  failOnCode(code)?;
  return;
}

pub fun readFile(filePath: noescape StringView) String!FsError {
  var pathBuf = pathBuffer(filePath);
  if pathBuf == null {
    fail FsError.OutOfMemory;
    return "";
  }
  var mode = "rb";
  var file = fopen(pathBuf, mode);
  mem.free(pathBuf as *Void);
  if file == null {
    fail errorFromCode(lastErrorCode());
    return "";
  }
  if fseek(file, 0, 2) != 0 {
    var code = lastErrorCode();
    fclose(file);
    fail errorFromCode(code);
    return "";
  }
  var size = ftell(file);
  if size < 0 {
    var code = lastErrorCode();
    fclose(file);
    fail errorFromCode(code);
    return "";
  }
  if fseek(file, 0, 0) != 0 {
    var code = lastErrorCode();
    fclose(file);
    fail errorFromCode(code);
    return "";
  }
  var buffer = mem.malloc(size + 1) as *Char;
  if buffer == null {
    fclose(file);
    fail FsError.OutOfMemory;
    return "";
  }
  var read = fread(buffer as *Void, 1, size as UInt, file);
  var closeCode = fclose(file);
  if (read != (size as UInt)) || closeCode != 0 {
    mem.free(buffer as *Void);
    fail errorFromCode(closeCode != 0 ? lastErrorCode() : 5);
    return "";
  }
  unsafe {
    *(buffer + size) = '\0';
  }
  var content = zap_string_from_ptrlen(buffer, size);
  mem.free(buffer as *Void);
  return content;
}

pub fun writeFile(filePath: noescape StringView, content: noescape StringView) Void!FsError {
  var pathBuf = pathBuffer(filePath);
  if pathBuf == null {
    fail FsError.OutOfMemory;
    return;
  }
  var mode = "wb";
  var file = fopen(pathBuf, mode);
  mem.free(pathBuf as *Void);
  if file == null {
    fail errorFromCode(lastErrorCode());
    return;
  }
  var contentLen = len(content);
  var written: UInt;
  unsafe {
    written = fwrite(getDataPtr(content) as *Void, 1, contentLen, file);
  }
  var closeCode = fclose(file);
  if (written != (contentLen as UInt)) || closeCode != 0 {
    fail errorFromCode(closeCode != 0 ? lastErrorCode() : 5);
    return;
  }
  return;
}

pub fun remove(target: noescape StringView) Void!FsError {
  var pathBuf = pathBuffer(target);
  if pathBuf == null {
    fail FsError.OutOfMemory;
    return;
  }
  var result = remove(pathBuf);
  var code = result == 0 ? 0 : lastErrorCode();
  mem.free(pathBuf as *Void);
  failOnCode(code)?;
  return;
}

pub fun rename(from: noescape StringView, to: noescape StringView) Void!FsError {
  var fromBuf = pathBuffer(from);
  var toBuf = pathBuffer(to);
  if fromBuf == null || toBuf == null {
    if fromBuf != null {
      mem.free(fromBuf as *Void);
    }
    if toBuf != null {
      mem.free(toBuf as *Void);
    }
    fail FsError.OutOfMemory;
    return;
  }
  var result = rename(fromBuf, toBuf);
  var code = result == 0 ? 0 : lastErrorCode();
  mem.free(fromBuf as *Void);
  mem.free(toBuf as *Void);
  failOnCode(code)?;
  return;
}

pub fun mkdirAll(target: String) Void!FsError {
  if string.len(target) == 0 {
    fail FsError.InvalidPath;
    return;
  }

  if isDir(target) {
    return;
  }

  var parentDir: String = path.parent(target);
  if !string.eq(parentDir, ".") && !string.eq(parentDir, target) {
    mkdirAll(parentDir)?;
  }

  mkdir(target) or err {
    if !isDir(target) {
      fail err;
      return;
    }
  };
  return;
}

pub fun ensureDir(target: String) Void!FsError {
  if string.len(target) == 0 {
    fail FsError.InvalidPath;
    return;
  }
  if isDir(target) {
    return;
  }
  if exists(target) {
    fail FsError.AlreadyExists;
    return;
  }
  mkdirAll(target)?;
  return;
}

pub fun writeFileSafe(filePath: String, content: String) Void!FsError {
  if string.len(filePath) == 0 {
    fail FsError.InvalidPath;
    return;
  }

  var parentDir: String = path.parent(filePath);
  if !string.eq(parentDir, ".") {
    ensureDir(parentDir)?;
  }
  writeFile(filePath, content)?;
  return;
}

pub fun touch(filePath: String) Void!FsError {
  if string.len(filePath) == 0 {
    fail FsError.InvalidPath;
    return;
  }
  if isDir(filePath) {
    fail FsError.IsDirectory;
    return;
  }
  if isFile(filePath) {
    return;
  }
  writeFileSafe(filePath, "")?;
  return;
}

pub fun move(from: String, to: String) Void!FsError {
  if string.len(from) == 0 || string.len(to) == 0 {
    fail FsError.InvalidPath;
    return;
  }

  var parentDir: String = path.parent(to);
  if !string.eq(parentDir, ".") {
    ensureDir(parentDir)?;
  }
  rename(from, to)?;
  return;
}

pub fun copyFile(from: String, to: String) Void!FsError {
  if string.len(from) == 0 || string.len(to) == 0 {
    fail FsError.InvalidPath;
    return;
  }
  if !isFile(from) {
    fail FsError.NotFound;
    return;
  }

  var parentDir: String = path.parent(to);
  if !string.eq(parentDir, ".") {
    ensureDir(parentDir)?;
  }
  var content: String = readFile(from)?;
  writeFile(to, content)?;
  return;
}

pub fun readLines(filePath: String) collection.List<String>!FsError {
  if string.len(filePath) == 0 {
    fail FsError.InvalidPath;
    return new collection.List<String>();
  }

  var content: String = readFile(filePath)?;
  var out: collection.List<String> = new collection.List<String>();
  var n: Int = string.len(content);
  var start: Int = 0;
  var i: Int = 0;
  while i < n {
    if string.at(content, i) == '\n' {
      var lineLen: Int = i - start;
      if lineLen > 0 && string.at(content, i - 1) == '\r' {
        lineLen = lineLen - 1;
      }
      out.push(string.slice(content, start, lineLen));
      start = i + 1;
    }
    i = i + 1;
  }
  if start < n {
    out.push(string.slice(content, start, n - start));
  }
  return out;
}

pub fun writeLines(filePath: String, lines: collection.List<String>) Void!FsError {
  if string.len(filePath) == 0 {
    fail FsError.InvalidPath;
    return;
  }

  var buf: string.TextBuf = new string.TextBuf();
  var n: Int = lines.len();
  var i: Int = 0;
  while i < n {
    buf.push(string.view(lines.at(i)));
    if i + 1 < n {
      buf.push("\n");
    }
    i = i + 1;
  }
  writeFileSafe(filePath, buf.build())?;
  return;
}
