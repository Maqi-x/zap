import "std/mem";

unsafe fun sumNativeBuffer(values: *Int, count: Int) Int {
    var total = 0;
    var index = 0;
    while index < count {
        total = total + *(values + index);
        index = index + 1;
    }
    return total;
}

fun main() Int {
    var total = 0;
    unsafe {
        var values = mem.malloc(3 * sizeof(Int)) as *Int;
        if values == null {
            return 1;
        }

        *values = 10;
        *(values + 1) = 20;
        *(values + 2) = 30;
        total = sumNativeBuffer(values, 3);
        mem.free(values as *Void);
    }

    println("Native total: " + toString(total));
    return 0;
}
